# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key de Supabase (sb_publishable_...) — segura de exponer en el cliente
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secreto para firmar los JWT de los enlaces de reporte (HS256)
# Generar con: openssl rand -base64 48
REPORT_LINK_SECRET=

# URL pública de la app, usada para construir los enlaces compartibles
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cifrado de los tokens de las plataformas (AES-256-GCM)
# Generar con: openssl rand -base64 32
PLATFORM_TOKEN_KEY=

# App de Meta para el OAuth de Meta Ads (developers.facebook.com/apps)
META_APP_ID=
META_APP_SECRET=

# App de TikTok for Business para el OAuth de TikTok Ads
# (business-api.tiktok.com → My Apps → Basic Information)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Ingesta de Google Ads (camino en uso): los datos los empuja un script
# programado dentro de Google Ads, no se piden a ninguna API.
#
# Secreto compartido con ese script. Generar con: openssl rand -base64 32
# y pegar el mismo valor en la constante ADSME_SECRET del script
GOOGLE_ADS_INGEST_SECRET=

# Clave de servicio de Supabase, necesaria porque el script no tiene sesión de
# usuario y debe escribir saltandose RLS. Supabase Dashboard -> Project Settings
# -> API Keys -> secret / service_role. NUNCA exponerla al cliente
# Formato: prefijo sb_secret_ seguido de una cadena larga
SUPABASE_SECRET_KEY=

# --- Alternativa por API, hoy sin usar ---
# Solo hacen falta si algun dia se cambia el script por llamadas directas a la
# API de Google Ads, que exige developer token aprobado en nivel Basic Access.
# Google Ads API — credenciales fijas del servidor: una misma cuenta de ads
# para todos los usuarios, sin OAuth por usuario como en Meta o TikTok
#
# Token de desarrollador: cuenta MCC de Google Ads →
# Herramientas y configuración → Configuración → API Center
# Debe estar en nivel Basic Access; con Test Account Access la API responde
# DEVELOPER_TOKEN_NOT_APPROVED contra cuentas reales
# Formato: 22 caracteres alfanumericos, sin prefijo
GOOGLE_ADS_DEVELOPER_TOKEN=

# Cliente OAuth: console.cloud.google.com → APIs y servicios → Credenciales →
# Crear credenciales → ID de cliente de OAuth, con la Google Ads API habilitada
# Formato: <numero de proyecto>-<cadena larga> y termina en googleusercontent
GOOGLE_ADS_CLIENT_ID=
# Formato: prefijo GOCSPX- seguido de unos 28 caracteres
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token de la cuenta de Google dueña de los anuncios. Se genera una vez
# en developers.google.com/oauthplayground con el cliente OAuth de arriba y el
# scope https://www.googleapis.com/auth/adwords. No caduca salvo revocación
# Formato: empieza por 1// y ronda los 100 caracteres
# (siempre empieza por 1// y ronda los 100 caracteres)
GOOGLE_ADS_REFRESH_TOKEN=

# ID de la cuenta MCC sin guiones. Solo si se accede a través del manager
# Ejemplo: 1234567890  (en la interfaz de Google se ve como 123-456-7890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ID de la cuenta de anuncios que se va a sincronizar, sin guiones
# Ejemplo: 9876543210
GOOGLE_ADS_CUSTOMER_ID=
